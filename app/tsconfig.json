{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "strict": true,
        "declaration":true,
        "noImplicitAny": true,
        "sourceMap": false,
        "skipLibCheck": true,
        "outDir": "./dist",
    },
    "include": [
      "src/**/*"
    ],
    "exclude": ["node_modules", "dist", "build"]
}
